            {
              "fieldId": "Call Attempts",
              "fieldValue": "={{ $('📊 Get Candidates to Call').item.json['Call Attempts'] + 1 }}"
            }
          ]
        }
      },
      "id": "update-status-in-progress",
      "name": "📝 Update Status: In Progress",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1600, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable API Token"
        }
