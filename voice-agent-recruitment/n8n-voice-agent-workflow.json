    {
      "parameters": {
        "jsCode": "// Parse ElevenLabs webhook data\nconst webhookData = $input.first().json;\n\n// Extract call outcome and collected data\nconst conversationData = webhookData.conversation_data || {};\nconst analysis = webhookData.analysis || {};\nconst metadata = webhookData.metadata || {};\n\n// Map ElevenLabs outcomes to our status values\nconst outcomeMapping = {\n  'interested': 'Completed - Interested',\n  'not_interested': 'Completed - Not Interested',\n  'callback': 'Call Back Later',\n  'no_answer': 'No Answer',\n  'voicemail': 'Voicemail Left',\n  'wrong_number': 'Wrong Number',\n  'opted_out': 'Do Not Call'\n};\n\n// Extract collected information\nconst callData = {\n  airtable_candidate_id: metadata.airtable_candidate_id,\n  elevenlabs_call_id: webhookData.conversation_id,\n  \n  // Call metadata\n  call_duration: webhookData.duration_seconds || 0,\n  recording_url: webhookData.recording_url || '',\n  transcript: webhookData.transcript || '',\n  \n  // Outcome\n  call_outcome: analysis.call_outcome || 'unknown',\n  call_status: outcomeMapping[analysis.call_outcome] || 'Completed - Not Interested',\n  \n  // Collected data\n  employment_status: analysis.employment_status || '',\n  availability: analysis.availability || '',\n  salary_expectation: analysis.salary_expectation || '',\n  location_preference: analysis.location_preference || '',\n  preferred_location: analysis.preferred_location || '',\n  updated_skills: analysis.updated_skills || '',\n  \n  // Assessment\n  interest_level: analysis.interest_level || 3,\n  sentiment: analysis.sentiment || 'neutral',\n  follow_up_required: analysis.interest_level >= 4,\n  follow_up_notes: analysis.follow_up_notes || '',\n  callback_datetime: analysis.callback_datetime || null,\n  \n  // For opt-out\n  do_not_call: analysis.call_outcome === 'opted_out'\n};\n\nreturn callData;"
      },
