    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "YOUR_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Client Requirements",
          "mode": "list"
        },
        "filterByFormula": "AND({Active}=TRUE(), {Niche/Industry}='{{ $json[\"Niche/Industry\"] }}')",
        "options": {
          "fields": [
            "Job Title",
            "Client Company",
            "Salary Range Min",
            "Salary Range Max",
            "Location",
            "Remote Option",
            "Required Skills"
          ]
        }
      },
      "id": "get-matching-job",
      "name": "💼 Get Matching Job",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1000, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable API Token"
        }
      },
      "notes": "Gets active job requirement matching candidate's niche"
    },
    {
      "parameters": {
        "jsCode": "// Prepare data for ElevenLabs API call\nconst candidate = $('📊 Get Candidates to Call').item.json;\nconst job = $('💼 Get Matching Job').first().json;\n\n// Format salary range\nconst salaryRange = job['Salary Range Min'] && job['Salary Range Max'] \n  ? `$${job['Salary Range Min'].toLocaleString()} - $${job['Salary Range Max'].toLocaleString()}`\n  : 'Competitive salary';\n\n// Build the dynamic variables for the prompt\nconst dynamicVariables = {\n  agency_name: 'YOUR_AGENCY_NAME', // Replace with your agency name\n  candidate_name: candidate['Full Name'].split(' ')[0], // First name only\n  candidate_email: candidate['Email'] || '',\n  previous_role: candidate['Previous Role Applied'] || 'a position',\n  niche: candidate['Niche/Industry'] || 'your field',\n  job_title: job['Job Title'] || 'an exciting opportunity',\n  company_name: job['Client Company'] || 'one of our clients',\n  job_location: job['Location'] || job['Remote Option'] || 'Flexible',\n  salary_range: salaryRange,\n  last_location: candidate['Last Known Location'] || '',\n  callback_number: 'YOUR_CALLBACK_NUMBER', // Replace with your number\n  recruiter_name: candidate['Recruiter Assigned'] || 'our team'\n};\n\n// Format phone number for ElevenLabs (E.164 format)\nlet phoneNumber = candidate['Phone Number'];\nif (phoneNumber && !phoneNumber.startsWith('+')) {\n  phoneNumber = '+1' + phoneNumber.replace(/\\D/g, '');\n}\n\nreturn {\n  candidate_id: candidate.id,\n  phone_number: phoneNumber,\n  first_message: `Hi, is this ${dynamicVariables.candidate_name}?`,\n  dynamic_variables: dynamicVariables,\n  metadata: {\n    airtable_candidate_id: candidate.id,\n    niche: candidate['Niche/Industry'],\n    job_id: job.id || null\n  }\n};"
      },
      "id": "prepare-call-data",
      "name": "⚙️ Prepare Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200],
      "notes": "Formats candidate and job data for ElevenLabs API"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/convai/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"agent_id\": \"YOUR_ELEVENLABS_AGENT_ID\",\n  \"phone_number\": \"{{ $json.phone_number }}\",\n  \"first_message\": \"{{ $json.first_message }}\",\n  \"dynamic_variables\": {{ JSON.stringify($json.dynamic_variables) }},\n  \"metadata\": {{ JSON.stringify($json.metadata) }},\n  \"webhook_url\": \"YOUR_N8N_WEBHOOK_URL/webhook/elevenlabs-call-complete\"\n}",
        "options": {}
      },
      "id": "initiate-elevenlabs-call",
      "name": "📞 Initiate ElevenLabs Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_ELEVENLABS_CREDENTIAL_ID",
          "name": "ElevenLabs API Key"
        }
      },
      "notes": "Initiates outbound call via ElevenLabs Conversational AI"
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "YOUR_BASE_ID",
          "mode": "id"
