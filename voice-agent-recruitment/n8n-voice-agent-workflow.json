    {
      "parameters": {
        "fromEmail": "notifications@youragency.com",
        "toEmail": "={{ $('👤 Get Recruiter Info').item.json.fields['Email'] }}",
        "subject": "🔥 Hot Lead Alert: {{ $('📊 Get Candidate Details').item.json.fields['Full Name'] }}",
        "emailType": "html",
        "html": "=<h2>Hot Lead Alert!</h2>\n<p>A candidate just expressed high interest in our opportunity!</p>\n\n<h3>Candidate Details</h3>\n<ul>\n  <li><strong>Name:</strong> {{ $('📊 Get Candidate Details').item.json.fields['Full Name'] }}</li>\n  <li><strong>Phone:</strong> {{ $('📊 Get Candidate Details').item.json.fields['Phone Number'] }}</li>\n  <li><strong>Email:</strong> {{ $('📊 Get Candidate Details').item.json.fields['Email'] }}</li>\n  <li><strong>Niche:</strong> {{ $('📊 Get Candidate Details').item.json.fields['Niche/Industry'] }}</li>\n</ul>\n\n<h3>Call Summary</h3>\n<ul>\n  <li><strong>Interest Level:</strong> {{ $('🔍 Parse Call Results').item.json.interest_level }}/5</li>\n  <li><strong>Availability:</strong> {{ $('🔍 Parse Call Results').item.json.availability }}</li>\n  <li><strong>Salary Expectation:</strong> {{ $('🔍 Parse Call Results').item.json.salary_expectation }}</li>\n  <li><strong>Location Preference:</strong> {{ $('🔍 Parse Call Results').item.json.location_preference }}</li>\n  <li><strong>Employment Status:</strong> {{ $('🔍 Parse Call Results').item.json.employment_status }}</li>\n</ul>\n\n<h3>Skills Mentioned</h3>\n<p>{{ $('🔍 Parse Call Results').item.json.updated_skills }}</p>\n\n<h3>Notes</h3>\n<p>{{ $('🔍 Parse Call Results').item.json.follow_up_notes }}</p>\n\n<p><strong>Recording:</strong> <a href=\"{{ $('🔍 Parse Call Results').item.json.recording_url }}\">Listen to call</a></p>\n\n<p><a href=\"https://airtable.com/YOUR_BASE_ID/YOUR_TABLE_ID/{{ $('📊 Get Candidate Details').item.json.id }}\">View in Airtable</a></p>\n\n<p>Please follow up within 24 hours!</p>",
        "options": {}
      },
