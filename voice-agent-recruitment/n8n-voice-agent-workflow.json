    {
      "parameters": {
        "httpMethod": "POST",
        "path": "elevenlabs-call-complete",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-call-complete",
      "name": "🔔 Webhook: Call Complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 500],
      "webhookId": "elevenlabs-call-complete",
      "notes": "Receives call completion data from ElevenLabs"
