{
  "name": "Voice Agent Recruitment - Complete System",
  "nodes": [
    {
      "parameters": {},
      "id": "workflow-description",
      "name": "📋 Workflow Overview",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [0, 0],
      "notes": "This workflow system includes:\n1. TRIGGER: Initiate calls from Airtable\n2. WEBHOOK: Receive call results from ElevenLabs\n3. UPDATE: Store results back to Airtable\n4. NOTIFY: Alert recruiters of hot leads"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "⏰ Hourly Call Scheduler",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 200],
      "notes": "Runs every hour during business hours (configure timezone)"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "business-hours-check",
              "leftValue": "={{ $now.hour }}",
              "rightValue": 8,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "business-hours-check-2",
              "leftValue": "={{ $now.hour }}",
              "rightValue": 20,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-business-hours",
      "name": "🕐 Business Hours Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, 200],
      "notes": "Only run between 8am-8pm (TCPA compliance)"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "YOUR_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Candidates",
          "mode": "list"
        },
        "filterByFormula": "AND({Call Status}='Pending Call', {Do Not Call}=FALSE(), {Call Attempts}<3)",
        "options": {
          "fields": [
            "Full Name",
            "Phone Number",
            "Email",
            "Previous Role Applied",
            "Niche/Industry",
            "Last Known Salary",
            "Last Known Location",
            "Recruiter Assigned"
          ]
        }
      },
      "id": "get-candidates-to-call",
      "name": "📊 Get Candidates to Call",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [600, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable API Token"
        }
