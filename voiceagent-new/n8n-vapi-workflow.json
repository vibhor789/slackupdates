            },
            {
              "fieldId": "ElevenLabs Call ID",
              "fieldValue": "={{ $json.vapi_call_id }}"
            }
          ]
        }
      },
      "id": "create-call-record",
      "name": "📝 Create Call Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [600, 500],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Token"
        }
      }
    },
