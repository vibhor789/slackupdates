    {
      "parameters": {
        "fromEmail": "notifications@youragency.com",
        "toEmail": "={{ $('👤 Get Recruiter').item.json.fields?.['Email'] || 'default@youragency.com' }}",
        "subject": "🔥 Hot Lead: {{ $('📊 Get Candidate Info').item.json.fields['Full Name'] }}",
        "emailType": "html",
        "html": "=<h2>🔥 Hot Lead Alert!</h2>\n\n<p>A candidate just expressed <strong>high interest</strong> in our opportunity!</p>\n\n<h3>Candidate Details</h3>\n<table border=\"1\" cellpadding=\"8\" style=\"border-collapse: collapse;\">\n  <tr><td><strong>Name</strong></td><td>{{ $('📊 Get Candidate Info').item.json.fields['Full Name'] }}</td></tr>\n  <tr><td><strong>Phone</strong></td><td>{{ $('📊 Get Candidate Info').item.json.fields['Phone Number'] }}</td></tr>\n  <tr><td><strong>Email</strong></td><td>{{ $('📊 Get Candidate Info').item.json.fields['Email'] }}</td></tr>\n  <tr><td><strong>Niche</strong></td><td>{{ $('📊 Get Candidate Info').item.json.fields['Niche/Industry'] }}</td></tr>\n</table>\n\n<h3>Call Summary</h3>\n<table border=\"1\" cellpadding=\"8\" style=\"border-collapse: collapse;\">\n  <tr><td><strong>Interest Level</strong></td><td>{{ $('🔍 Parse Results').item.json.interest_level }}/5</td></tr>\n  <tr><td><strong>Availability</strong></td><td>{{ $('🔍 Parse Results').item.json.availability || 'Not specified' }}</td></tr>\n  <tr><td><strong>Salary Expectation</strong></td><td>{{ $('🔍 Parse Results').item.json.salary_expectation || 'Not specified' }}</td></tr>\n  <tr><td><strong>Location Preference</strong></td><td>{{ $('🔍 Parse Results').item.json.location_preference || 'Not specified' }}</td></tr>\n  <tr><td><strong>Employment Status</strong></td><td>{{ $('🔍 Parse Results').item.json.employment_status || 'Not specified' }}</td></tr>\n</table>\n\n<h3>Skills Mentioned</h3>\n<p>{{ $('🔍 Parse Results').item.json.updated_skills || 'None mentioned' }}</p>\n\n<h3>Notes</h3>\n<p>{{ $('🔍 Parse Results').item.json.follow_up_notes || 'No additional notes' }}</p>\n\n<h3>Recording</h3>\n<p><a href=\"{{ $('🔍 Parse Results').item.json.recording_url }}\">🎧 Listen to Call Recording</a></p>\n\n<p><a href=\"https://airtable.com/YOUR_AIRTABLE_BASE_ID/tblXXXXXX/{{ $('📊 Get Candidate Info').item.json.id }}\" style=\"background: #0066cc; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;\">View in Airtable</a></p>\n\n<p style=\"color: #cc0000;\"><strong>Please follow up within 24 hours!</strong></p>",
        "options": {}
      },
