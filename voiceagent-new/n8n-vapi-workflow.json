{
  "name": "Voice Agent Recruitment - Vapi",
  "nodes": [
    {
      "parameters": {},
      "id": "workflow-info",
      "name": "📋 Workflow Info",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [0, 0],
      "notes": "Voice Agent Recruitment System using Vapi + ElevenLabs\n\nFlows:\n1. Scheduled outbound calls from Airtable\n2. Webhook receives call results\n3. Updates Airtable with outcomes\n4. Notifies recruiters of hot leads"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "⏰ Hourly Scheduler",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 200],
      "notes": "Runs every hour to check for candidates to call"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "hour-check-start",
              "leftValue": "={{ $now.hour }}",
              "rightValue": 8,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "hour-check-end",
              "leftValue": "={{ $now.hour }}",
              "rightValue": 20,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "business-hours-check",
      "name": "🕐 Business Hours?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, 200],
      "notes": "Only call between 8am-8pm (TCPA)"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Candidates",
          "mode": "list"
        },
        "filterByFormula": "AND({Call Status}='Pending Call', {Do Not Call}=FALSE(), {Call Attempts}<3)",
        "options": {
          "fields": [
            "Full Name",
            "Phone Number",
            "Email",
            "Previous Role Applied",
            "Niche/Industry",
            "Last Known Salary",
            "Last Known Location",
            "Recruiter Assigned"
          ]
        }
      },
      "id": "get-candidates",
      "name": "📊 Get Candidates",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [600, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 5,
        "options": {}
      },
      "id": "batch-candidates",
      "name": "📦 Batch (5 at a time)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [800, 200]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Client Requirements",
          "mode": "list"
        },
        "filterByFormula": "AND({Active}=TRUE(), {Niche/Industry}='{{ $json[\"Niche/Industry\"] }}')",
        "options": {
          "fields": [
            "Job Title",
            "Client Company",
            "Salary Range Min",
            "Salary Range Max",
            "Location",
            "Remote Option"
          ]
        }
      },
      "id": "get-matching-job",
      "name": "💼 Get Job Match",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1000, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Prepare call data for Vapi\nconst candidate = $('📊 Get Candidates').item.json;\nconst job = $('💼 Get Job Match').first()?.json || {};\n\n// Format salary range\nconst salaryMin = job['Salary Range Min'];\nconst salaryMax = job['Salary Range Max'];\nconst salaryRange = salaryMin && salaryMax \n  ? `$${salaryMin.toLocaleString()} to $${salaryMax.toLocaleString()}`\n  : 'competitive salary';\n\n// Format phone (E.164)\nlet phone = candidate['Phone Number'] || '';\nif (phone && !phone.startsWith('+')) {\n  phone = '+1' + phone.replace(/\\D/g, '');\n}\n\n// Build assistant overrides with dynamic variables\nconst assistantOverrides = {\n  variableValues: {\n    agency_name: 'YOUR_AGENCY_NAME',\n    candidate_name: (candidate['Full Name'] || '').split(' ')[0],\n    candidate_email: candidate['Email'] || '',\n    previous_role: candidate['Previous Role Applied'] || 'a position',\n    niche: candidate['Niche/Industry'] || 'your field',\n    job_title: job['Job Title'] || 'an exciting opportunity',\n    company_name: job['Client Company'] || 'one of our clients',\n    job_location: job['Location'] || job['Remote Option'] || 'flexible location',\n    salary_range: salaryRange,\n    callback_number: 'YOUR_CALLBACK_NUMBER'\n  }\n};\n\nreturn {\n  candidate_id: candidate.id,\n  phone_number: phone,\n  candidate_name: candidate['Full Name'],\n  niche: candidate['Niche/Industry'],\n  assistant_overrides: assistantOverrides,\n  metadata: {\n    airtable_candidate_id: candidate.id,\n    airtable_job_id: job.id || null,\n    niche: candidate['Niche/Industry']\n  }\n};"
      },
      "id": "prepare-call-data",
      "name": "⚙️ Prepare Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vapi.ai/call/phone",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"assistantId\": \"YOUR_VAPI_ASSISTANT_ID\",\n  \"phoneNumberId\": \"YOUR_VAPI_PHONE_NUMBER_ID\",\n  \"customer\": {\n    \"number\": \"{{ $json.phone_number }}\",\n    \"name\": \"{{ $json.candidate_name }}\"\n  },\n  \"assistantOverrides\": {{ JSON.stringify($json.assistant_overrides) }},\n  \"metadata\": {{ JSON.stringify($json.metadata) }}\n}",
        "options": {}
      },
      "id": "vapi-make-call",
      "name": "📞 Vapi: Make Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_VAPI_CREDENTIAL_ID",
          "name": "Vapi API Key"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Candidates",
          "mode": "list"
        },
        "id": "={{ $('⚙️ Prepare Call Data').item.json.candidate_id }}",
        "fields": {
          "fieldValues": [
            {
              "fieldId": "Call Status",
              "fieldValue": "In Progress"
            },
            {
              "fieldId": "Last Call Date",
              "fieldValue": "={{ $now.toISO() }}"
            },
            {
              "fieldId": "Call Attempts",
              "fieldValue": "={{ $('📊 Get Candidates').item.json['Call Attempts'] + 1 }}"
            }
          ]
        }
      },
      "id": "update-status-calling",
      "name": "📝 Status: In Progress",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1600, 200],
      "credentials": {
        "airtableTokenApi": {
          "id": "YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable Token"
        }
      }
    },
    {
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      },
      "id": "wait-between-calls",
      "name": "⏳ Wait 60s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1800, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vapi-call-complete",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-call-complete",
      "name": "🔔 Webhook: Call Done",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 500],
      "webhookId": "vapi-call-complete"
    },
    {
      "parameters": {
        "jsCode": "// Parse Vapi webhook data\nconst data = $input.first().json;\nconst message = data.message || {};\nconst call = message.call || {};\nconst analysis = message.analysis || {};\nconst metadata = call.metadata || {};\n\n// Map outcomes\nconst outcomeMap = {\n  'interested': 'Completed - Interested',\n  'not_interested': 'Completed - Not Interested',\n  'callback': 'Call Back Later',\n  'no_answer': 'No Answer',\n  'voicemail': 'Voicemail Left',\n  'opted_out': 'Do Not Call',\n  'wrong_number': 'Wrong Number'\n};\n\nconst structuredData = analysis.structuredData || {};\nconst callOutcome = structuredData.call_outcome || 'unknown';\n\nreturn {\n  // IDs\n  airtable_candidate_id: metadata.airtable_candidate_id,\n  vapi_call_id: call.id,\n  \n  // Call info\n  call_duration: call.duration || message.durationSeconds || 0,\n  recording_url: call.recordingUrl || message.recordingUrl || '',\n  transcript: message.transcript || '',\n  \n  // Outcome mapping\n  call_outcome: callOutcome,\n  call_status: outcomeMap[callOutcome] || 'Completed - Not Interested',\n  \n  // Extracted data\n  employment_status: structuredData.employment_status || '',\n  availability: structuredData.availability || '',\n  salary_expectation: structuredData.salary_expectation || '',\n  location_preference: structuredData.location_preference || '',\n  updated_skills: structuredData.updated_skills || '',\n  \n  // Assessment\n  interest_level: structuredData.interest_level || 3,\n  follow_up_notes: structuredData.follow_up_notes || '',\n  callback_requested: structuredData.callback_requested || false,\n  callback_time: structuredData.callback_time || '',\n  \n  // Flags\n  is_hot_lead: (structuredData.interest_level || 0) >= 4,\n  do_not_call: callOutcome === 'opted_out',\n  \n  // Sentiment from Vapi\n  sentiment: analysis.successEvaluation || 'neutral'\n};"
      },
      "id": "parse-vapi-webhook",
      "name": "🔍 Parse Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 500]
    },
